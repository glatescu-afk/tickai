# --- H Company : Agents API ---
# Clé créée sur https://platform.hcompany.ai/settings/api-keys (affichée une seule fois)
HAI_API_KEY=hk-xxxxxxxxxxxxxxxxxxxxxxxx
# EU par défaut ; US = https://agp.hcompany.ai/api/v2
HAI_BASE_URL=https://agp.eu.hcompany.ai/api/v2
# Nom de base de l'agent desktop (en served desktop, un suffixe de session est ajouté)
HAI_DESKTOP_AGENT=tickai-teams-desktop
# Montage : 1 = served desktop (PRODUIT, service dans le cloud qui pilote une
# machine cible à distance) ; 0 = auto-connect LOCAL (le service tourne sur la
# machine à l'écran, ex. ton Mac, et ouvre le bridge lui-même — test rapide).
HAI_SERVED_DESKTOP=1
# Served desktop : id de session que sert le bridge sur la machine cible.
# Démo mono-poste : poser le MÊME id ici (côté service/Render) et au lancement
# du bridge Mac via `./demo_desktop.sh` (qui force ce session_id fixe). Repli
# utilisé quand n8n n'envoie pas de session_id dans le body /run.
HAI_DESKTOP_SESSION_ID=a08dae4b-6695-426e-babf-70df99d873d2

# --- Supabase (écrit par n8n et le service ; clé service_role, JAMAIS dans le front) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n / mails (référence) ---
# Destinataire des alertes d'escalade (voir Guide Gabriel / Skill n8n)
SUPPORT_EMAIL=sranganadane+support@eugeniaschool.com

# --- Service HTTP ---
# Port d'écoute d'uvicorn (service_api:app)
PORT=8000
