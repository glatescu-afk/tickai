# --- H Company : Agents API ---
# Clé créée sur https://platform.hcompany.ai/settings/api-keys (affichée une seule fois)
HAI_API_KEY=hk-xxxxxxxxxxxxxxxxxxxxxxxx
# EU par défaut ; US = https://agp.hcompany.ai/api/v2
HAI_BASE_URL=https://agp.eu.hcompany.ai/api/v2
# Nom de l'agent desktop réutilisé entre les runs (Windows, mode visuel)
HAI_DESKTOP_AGENT=tickai-teams-desktop

# --- Supabase (écrit par n8n et le service ; clé service_role, JAMAIS dans le front) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n / mails (référence) ---
# Destinataire des alertes d'escalade (voir Guide Gabriel / Skill n8n)
SUPPORT_EMAIL=sranganadane+support@eugeniaschool.com

# --- Service HTTP ---
# Port d'écoute d'uvicorn (service_api:app)
PORT=8000
