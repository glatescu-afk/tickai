# --- H Company : Agents API ---
# Clé créée sur https://platform.hcompany.ai/settings/api-keys (affichée une seule fois)
HAI_API_KEY=hk-xxxxxxxxxxxxxxxxxxxxxxxx
# EU par défaut ; US = https://agp.hcompany.ai/api/v2
HAI_BASE_URL=https://agp.eu.hcompany.ai/api/v2

# --- Console de test N1 : GitLab (gestion des membres d'un groupe) ---
# Page des membres du groupe que l'agent pilote, p.ex. :
#   https://gitlab.com/groups/tickai-demo/-/group_members
CONSOLE_URL=https://gitlab.com/groups/tickai-demo/-/group_members
# Nom lisible du groupe/ressource (sert dans les consignes données à l'agent)
GITLAB_GROUP=tickai-demo

# Identifiants du compte de TEST dédié qui a le droit d'inviter des membres.
# Optionnel : laisse vide si tu utilises un Chrome déjà connecté (environnement user_device).
# ATTENTION : utilise un compte jetable sans 2FA. Ces valeurs sont envoyées à l'agent cloud.
GITLAB_EMAIL=
GITLAB_PASSWORD=

# Mode d'exécution de l'agent N1 :
#   cloud = navigateur hébergé par H (simple, mais bloqué par Cloudflare au login)
#   local = pilote TON Chrome local (passe Cloudflare, mais clics synthétiques KO sur boutons Vue.js)
#   desktop = pilote la vraie souris/clavier (vrais clics, OK sur Vue.js ; permissions macOS requises) — recommandé
HAI_RUN_MODE=local
